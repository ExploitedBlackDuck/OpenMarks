{
  "compilerOptions": {
    "baseUrl": ".", "inlineSourceMap": true, "inlineSources": true,
    "module": "ESNext", "target": "ES2022", "allowJs": true,
    "noImplicitAny": true, "moduleResolution": "Bundler", "importHelpers": true,
    "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "useDefineForClassFields": true, "lib": ["DOM", "DOM.Iterable", "ES2022"], "skipLibCheck": true,
    "allowImportingTsExtensions": true, "types": []
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
